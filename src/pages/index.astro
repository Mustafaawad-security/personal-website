---
 import Header from "../components/Header.astro";
 import portrait from "../assets/personal-image.png";
---

<!DOCTYPE html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, intial-scale=1.0"/>
    <title>Home</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
        background-color: #fdfdfd;
        color: #0d0d0d;
        line-height: 1.5;
      }

      .container {
        max-width: 1300px;
        max-height: 1200px;
        margin: 0 auto;
        padding: 0 2.5rem;
      }

      main {
        padding: 2rem 0 4rem;
      }

      .hero {
        display: grid;
        grid-template-columns: 55% 45%;
        grid-template-rows: repeat(5, 1fr);
        grid-template-areas:      
          "title       portrait"
          "description portrait"
          "focus       portrait"
          "social      portrait";
        gap: 2rem;
        align-items: stretch;
        min-height: 200px;
        max-height: 300px;
        margin-top: 80px;
      }
      .hero-content {
        padding-right: 1rem;
      }

      .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: #f3f3f3;
        padding: 0.35rem 0.9rem;
        border-radius: 100px;
        font-size: 0.72rem;
        font-weight: 500;
        margin-bottom: 1.8rem;
        letter-spacing: 0.01em;
      }

      .badge::before {
        content: '';
        width: 8px;
        height: 8px;
        background: #0d0d0d;
        border-radius: 50%;
      }

      .title {
        grid-area: title;
      }

      h1 {
	      font-size: 4rem;
        font-weight: 700;
        line-height: 1.05;
        margin-bottom: 1.8rem;
        letter-spacing: -0.04em;
      }

      h1 span {
        font-style: italic;
        font-weight: 400;
        color: #555;
        font-family: Georgia, 'Times New Roman', Times, serif;
      }

      .description {
        grid-area: description;
        font-size: 0.98rem;
        color: #555;
        margin-bottom: 2.2rem;
        max-width: 520px;
        line-height: 1.7;
      }

      .buttons {
        display: flex;
        gap: 1.2rem;
        margin-bottom: 5rem;
        align-items: center;
      }

      .btn {
        padding: 0.9rem 1.8rem;
        border-radius: 12px;
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
        border: none;
        transition: all 0.2s ease;
      }

      .btn-primary {
        background: #0d0d0d;
        color: white;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
      }

      .btn-primary:hover {
        background: #262626;
      }

      .btn-secondary {
        background: transparent;
        color: #0d0d0d;
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.9rem 1rem;
        font-weight: 500;
      }

      .btn-secondary::before {
        content: '▶';
        font-size: 0.6rem;
        width: 28px;
        height: 28px;
        border: 2px solid #0d0d0d;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .social-links {
        grid-area: social;
        margin-top: 2rem;
      }

      .social-links p {
        font-size: 0.75rem;
        color: #888;
        margin-bottom: 1rem;
        letter-spacing: 0.08em;
      }

      .logos {
        display: flex;
        gap: 2.2rem;
        align-items: center;
        opacity: 0.5;
      }

      .logo-item {
        font-size: 0.9rem;
        font-weight: 600;
        color: #444;
        letter-spacing: 0.02em;
        text-decoration: underline;
      }

      .hero-image {
        position: relative;
        grid-area: portrait;
        height: auto;
      }

      .image-container {
        position: absolute;
        right: -4rem;
        top: 0;
        width: 120%;
        height: 100%;
      }

      .portrait-wrapper {
        position: relative;
        height: 100%;
        display: flex;
        justify-content: flex-end;
        align-items: flex-end;
        opacity: 0.95;
      }

      .portrait-wrapper img {
        height: 100%;
        width: auto;
        max-width: 100%;
        filter: grayscale(100%);
        object-fit: contain;
        mix-blend-mode: multiply;
      }

      .features {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
        margin-top: 3rem;
      }

       .feature-card {
        grid-area: focus;
        background: white;
        padding: 2rem;
        border-radius: 16px;
        border: 1px solid rgba(0, 0, 0, 0.05);
        transition: transform 0.3s ease;
        opacity: 0.8;
      }

      .feature-card:hover {
        transform: translateY(-4px);
      }
      
      .feature-title {
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 0.75rem;
      }

      .feature-desc {
        color: #555;
        font-size: 0.95rem;
        line-height: 1.6;
      }
    @media (max-width: 1030px) {
      h1 {
        font-size: clamp(2.2rem, 6vw, 4rem);
        margin-bottom: 0;
      }
      
     .feature-card p{
        font-size: clamp(0.9rem, 1rem, 1.2rem);
     }
     p.description {
        font-size: clamp(0.9rem, 1rem, 1.2rem);
     }

     .hero {
        grid-template-columns: minmax(200px, 496px); 
        grid-template-rows: repeat(5, 1fr);
        grid-template-areas:
          "title"
          "description"
          "portrait"
          "focus"
          "social";
        gap: clamp(0.8rem, 1.4rem, 1.6rem);
        min-height: auto;
        justify-items: stretch;
        justify-content: center;
        margin-top: 10px;
     }
      /* .hero-content {
         display: contents;
     }*/

     .title {
       grid-area: title;
       margin-bottom: 0;
     }

     .description {
       grid-area: description;
       margin-bottom: 0;
     }

     .hero-image {
      grid-area: portrait;
      max-width: 496px;
      height: clamp(250px, 120vw, 700px);
      justify-self: stretch;
     }

      .image-container {
      position: static;
      top: 0;
      width: 100%;  
      height: 100%;
      max-height: 100%;
      }

     .portrait-wrapper {
      justify-content: center;
      max-height: 100%;
       }

     .portrait-wrapper img {
       height: 100%;
       width: 100%;
       max-width: 100%;
       object-fit: contain;
     }

     .feature-card {
      grid-area: focus;
      max-width: 496px;
      justify-self: stretch;
     }

     .social-links {
      grid-area: social;
      margin-top: 10px;
     }
     .logos {
      margin-bottom: 10px;
     }
    }

    @media (max-width: 450px) {
        .feature-card p{
        font-size: clamp(0.75rem, 0.75rem, 1rem);
      }
    }
    </style>
  </head>
  <body> 
    <div class="container">
      <Header />
      <main>
        <section class="hero">
          <article class="title">
              <span class="badge">Cloud Security</span>
              <h1>Mustafa Awad <!--<br />--><span>Projects, Write-ups & Learning</span></h1>
              <!-- <div class="buttons">
                <a href="/product" style="text-decoration: none;">
                  <button class="btn btn-primary">Current focus</button>
                </a>
                <a href="/value" style="text-decoration: none;">
                  <button class="btn btn-secondary">查看工作原理</button>
                </a> 
              </div> -->
            </article>
            <p class="description">
              Building expertise in cloud security through hands-on projects, structured learning, and technical writing. This website serves as a public record of that journey.
            </p>
            <article class="feature-card">
              <h3 class="feature-title">Current Focus:</h3>
              <p class="feature-desc">• Personal Website Development<br/>
                                      • Linux Workstation Engineering Project<br/>
                                      • Programming & Automation
              </p>
            </article>
           <article class="social-links">
              <p>contact@mustafaawad.com</p>
              <nav class="logos">
                <a href="https://www.linkedin.com/in/mustafaawad-security/" target="_blank"><span class="logo-item">LinkedIn</span></a>
                <a href="https://github.com/Mustafaawad-security"           target="_blank"><span class="logo-item">GitHub</span></a>
                <a href="https://dev.to/mustafaawad"                        target="_blank"><span class="logo-item">Dev.to</span></a>
              </nav>
           </article>
          <div class="hero-image">
            <div class="image-container">
              <figure class="portrait-wrapper">
                <img src={portrait.src} alt="Portrait of Mustafa Awad"/>
              </figure>
            </div>
          </div>
        </section>
      </main>
    </div>
    <script>
      const langBtn = document.getElementById('langBtn');
      const langDropdown = document.getElementById('langDropdown');
      const langOptions = document.querySelectorAll('.language-option');

      langBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        langDropdown.classList.toggle('show');
      });

      document.addEventListener('click', () => {
        langDropdown.classList.remove('show');
      });

      langOptions.forEach(option => {
        option.addEventListener('click', () => {
          const lang = option.dataset.lang;
          langBtn.textContent = option.textContent;
          langDropdown.classList.remove('show');
          
          const path = window.location.pathname;
          if (lang === 'zh') {
            window.location.pathname = path.replace('/en', '') || '/';
          } else {
            window.location.pathname = '/en' + path;
          }
        });
      });
    </script>
  </body>
</html>
